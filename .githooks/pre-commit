#!/bin/sh
# Two independent drift gates, each only running when relevant files are
# staged:
#
# 1. Tokens/Styles — blocks if packages/tokens/** or STYLES.md are
#    internally inconsistent with their Figma export (sync figma /
#    check-styles). Doesn't talk to Figma itself; can only verify the repo
#    agrees with whatever the export files already contain. If Figma
#    changed and nobody re-pulled, this won't catch that — see CLAUDE.md's
#    "Figma Styles" section for the agent-driven pull step that keeps the
#    export files themselves fresh.
#
# 2. Components — blocks if a touched component's compiled CSS no longer
#    matches its declared figmaTokens mapping (check-parity). A component
#    with no figmaTokens yet (ERR_NO_FIGMA_SPEC) warns instead of blocking
#    — it hasn't opted into parity checking, it isn't drifting from a spec
#    that doesn't exist. Does NOT catch raw hardcoded values on properties
#    nobody declared in figmaTokens — see HOW-TO.md's component-editing
#    section for that open gap.
#
# 3. Docs — blocks if a staged .md file contains a known-stale term
#    (check-docs, e.g. a Figma collection's old pre-rename name asserted as
#    current). Append-only blocklist in packages/cli/bin/latent.mjs's
#    DOC_BLOCKLIST — doesn't catch general staleness, only terms someone's
#    already added there after finding them wrong once.
#
# `verify` (packages/cli/bin/latent.mjs) runs all of sync figma/check-styles/
# check-parity/check-docs unconditionally in one call — this hook doesn't
# use it, since running full parity across all 30 components on every commit
# regardless of what changed would be needless overhead; the scoping below
# is deliberate. Reach for `verify` yourself at the terminal, or see it run
# in .github/workflows/latent-sync-check.yml after every Latent Sync
# plugin push.
#
# Installed automatically via `npm install` (see package.json's postinstall,
# which runs `git config core.hooksPath .githooks`). Works for any commit
# regardless of what tool/agent authored it — this is a git hook, not an
# editor or agent-specific mechanism.

CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)
FAIL=0

json_status() {
  node -e "let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{console.log(JSON.parse(d).status)}catch(e){console.log('parse-error')}})"
}

# --- 0. Sample fixture ---
# figma-export.sample.json is a demo fixture with 3 intentional drift cases
# for exercising `sync figma`. It's generated from the same 4 schema files,
# so it can't silently accumulate unrelated staleness the way a hand-edited
# copy could (see generate-sample-fixture.mjs's header comment) — regenerate
# and re-stage it automatically whenever the schema changes.
SCHEMA_TOUCHED=$(printf '%s\n' "$CHANGED" | grep -E '^packages/tokens/(primitives|semantic|density|breakpoint)\.json$')
if [ -n "$SCHEMA_TOUCHED" ]; then
  echo "latent: token schema changed — regenerating figma-export.sample.json..."
  node packages/tokens/generate-sample-fixture.mjs
  git add packages/tokens/figma-export.sample.json
fi

# --- 1. Tokens/Styles ---
TOKENS_TOUCHED=$(printf '%s\n' "$CHANGED" | grep -E '^packages/tokens/|^STYLES\.md$')
if [ -n "$TOKENS_TOUCHED" ]; then
  echo "latent: token/style files changed — verifying sync before commit..."

  if [ -f packages/tokens/figma-export.live.json ]; then
    SYNC_OUT=$(node packages/cli/bin/latent.mjs sync figma --file packages/tokens/figma-export.live.json --json)
    SYNC_STATUS=$(printf '%s' "$SYNC_OUT" | json_status)
    if [ "$SYNC_STATUS" != "in-sync" ]; then
      echo ""
      echo "BLOCKED (sync figma): drift against packages/tokens/figma-export.live.json"
      echo "$SYNC_OUT"
      FAIL=1
    fi
  fi

  if [ -f packages/tokens/styles-export.live.json ]; then
    STYLES_OUT=$(node packages/cli/bin/latent.mjs check-styles --file packages/tokens/styles-export.live.json --json)
    STYLES_STATUS=$(printf '%s' "$STYLES_OUT" | json_status)
    if [ "$STYLES_STATUS" != "in-sync" ]; then
      echo ""
      echo "BLOCKED (check-styles): drift against packages/tokens/styles-export.live.json"
      echo "$STYLES_OUT"
      FAIL=1
    fi
  fi
fi

# --- 2. Components ---
COMPONENTS_TOUCHED=$(printf '%s\n' "$CHANGED" | grep -E '^packages/core/src/.*\.(tsx|css|doc\.mjs)$')
if [ -n "$COMPONENTS_TOUCHED" ]; then
  NAMES=$(printf '%s\n' "$COMPONENTS_TOUCHED" | sed -E 's#^packages/core/src/##; s#\..*##' | sort -u)
  echo "latent: component files changed — running check-parity..."
  for NAME in $NAMES; do
    PARITY_OUT=$(node packages/cli/bin/latent.mjs check-parity "$NAME" --json)
    PARITY_CODE=$(printf '%s' "$PARITY_OUT" | node -e "let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const o=JSON.parse(d);console.log(o.type==='error'?o.code:'')}catch(e){console.log('parse-error')}})")

    if [ "$PARITY_CODE" = "ERR_NO_FIGMA_SPEC" ]; then
      echo "WARN: $NAME has no figmaTokens mapping yet — check-parity skipped, not blocking."
      continue
    fi
    if [ -n "$PARITY_CODE" ]; then
      echo ""
      echo "BLOCKED (check-parity $NAME): $PARITY_CODE"
      echo "$PARITY_OUT"
      FAIL=1
      continue
    fi

    PARITY_STATUS=$(printf '%s' "$PARITY_OUT" | json_status)
    if [ "$PARITY_STATUS" != "matches" ]; then
      echo ""
      echo "BLOCKED (check-parity $NAME): compiled CSS no longer matches its declared figmaTokens"
      echo "$PARITY_OUT"
      FAIL=1
    fi
  done
fi

# --- 3. Docs ---
DOCS_TOUCHED=$(printf '%s\n' "$CHANGED" | grep -E '\.md$')
if [ -n "$DOCS_TOUCHED" ]; then
  echo "latent: markdown files changed — running check-docs..."
  DOCS_OUT=$(node packages/cli/bin/latent.mjs check-docs --json)
  DOCS_STATUS=$(printf '%s' "$DOCS_OUT" | json_status)
  if [ "$DOCS_STATUS" != "clean" ]; then
    echo ""
    echo "BLOCKED (check-docs): known-stale term found in a tracked .md file"
    echo "$DOCS_OUT"
    FAIL=1
  fi
fi

if [ "$FAIL" = "1" ]; then
  echo ""
  echo "Commit blocked. Fix the drift reported above before committing."
  exit 1
fi

if [ -n "$TOKENS_TOUCHED" ] || [ -n "$COMPONENTS_TOUCHED" ] || [ -n "$DOCS_TOUCHED" ]; then
  echo "latent: all checks passed."
fi
exit 0
