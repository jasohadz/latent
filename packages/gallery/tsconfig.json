{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,

    "baseUrl": ".",
    "paths": {
      "@latent/core/*": ["../core/src/*"],
      "@latent/theme/*": ["../theme-neutral/*"]
    }
  },
  "include": ["src", "../core/src"]
}
